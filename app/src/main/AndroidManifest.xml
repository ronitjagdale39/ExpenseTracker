<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera Permission -->
    <uses-permission android:name="android.permission.CAMERA" />


    <application
        android:allowBackup="true"
        android:icon="@drawable/expense_logo"
        android:label="Expense Tracker"
        android:roundIcon="@drawable/expense_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Expensetracker">


        <!-- ========================================= -->
        <!-- SPLASH SCREEN -->
        <!-- ========================================= -->

        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- ========================================= -->
        <!-- MAIN DASHBOARD -->
        <!-- ========================================= -->

        <activity
            android:name=".MainActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- ADD / EDIT TRANSACTION -->
        <!-- ========================================= -->

        <activity
            android:name=".AddTransactionActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- ANALYTICS -->
        <!-- ========================================= -->

        <activity
            android:name=".AnalyticsActivity"
            android:exported="false" />


        <!-- ========================================= -->
        <!-- SETTINGS -->
        <!-- ========================================= -->

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />


    </application>

</manifest>